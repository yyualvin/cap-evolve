# Copy this file to openshift/.env and fill in real values.
#   cp openshift/.env.example openshift/.env
#
# See openshift/README.md step 2 for how this file is consumed.

# --- Forwarded into the runner pod (becomes the cap-evolve-runner-env Secret) ---
ANTHROPIC_VERTEX_PROJECT_ID=<YOUR_GCP_PROJECT_ID>

# --- Local-machine only: used to build the gcp-vertex-credentials Secret file ---
# NOT forwarded into the pod as a literal env var — mounted as a file instead.
GCP_ADC_JSON="$HOME/.config/gcloud/application_default_credentials.json"

# --- Optional: only needed if you also deploy the vLLM manifests (gated HF models) ---
HF_TOKEN=<YOUR_HUGGINGFACE_TOKEN>
